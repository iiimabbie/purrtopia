# Discord Bot Token (Required)
# Get it from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild IDs (Optional)
# Comma-separated Discord server IDs
# Leave empty for global commands (takes up to 1 hour to propagate)
# Set specific guild IDs for instant command updates during development
# Example: GUILD_IDS=123456789,987654321
GUILD_IDS=

# Bot Permission (Optional)
# Comma-separated Discord user IDs
BOT_OWNER_IDS=
BOT_ADMIN_IDS=

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=heartopia
DB_PASSWORD=heartopia_secret
DB_NAME=heartopia

# Gemini AI Configuration
# Get API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback API (OpenAI-compatible endpoint)
# Used when primary API hits rate limits
GEMINI_FALLBACK_ENDPOINT=https://your-fallback-endpoint.com/v1
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
