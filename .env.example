# Discord Bot Token (Required)
# Get it from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild ID for testing (Optional)
# Leave empty for global commands (takes up to 1 hour to propagate)
# Set to a specific guild ID for instant command updates during development
GUILD_ID=

# Bot Permission (Optional)
# Comma-separated Discord user IDs
BOT_OWNER_IDS=
BOT_ADMIN_IDS=

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=heartopia
DB_PASSWORD=heartopia_secret
DB_NAME=heartopia
MYSQL_ROOT_PASSWORD=root_secret

# Gemini AI Configuration
# Get API Key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Keyword Trigger Configuration
# Comma-separated keywords that trigger AI classification
KEYWORD_TRIGGERS=粉紅,泡泡,粉泡,粉紅泡泡,螢石,溜溜木

# Channel Links for auto-reply
# Use Discord channel links or <#channel_id> format
CHANNEL_BUBBLE=https://discord.com/channels/xxx/yyy
CHANNEL_DAILY_TOWN=https://discord.com/channels/xxx/zzz
CHANNEL_WEATHER=https://discord.com/channels/xxx/aaa
CHANNEL_HELPER=https://discord.com/channels/xxx/www

# Enabled Channels (Optional)
# Comma-separated channel IDs where keyword triggers are active
# Leave empty to enable in all channels
KEYWORD_ENABLED_CHANNELS=
